<!-- INTERACTIVE QUIZ -->
<section id="quiz">
  <div class="container">
    <div class="sec-head center reveal">
      <span class="eyebrow">Подарок за 1 минуту</span>
      <h2>Получите персональный план ухода за волосами</h2>
      <p class="lead">Ответьте на 5 коротких вопросов — подскажем, какие шампуни, кондиционеры и средства для укладки подходят вашему типу волос.</p>
    </div>
    <div class="quiz-banner" role="img" aria-label="Средства для ухода за волосами и бородой на тёмном фоне"></div>
    <div class="quiz-shell reveal" id="styleQuiz">
      <aside class="quiz-aside">
        <div>
          <span class="eyebrow">Стальная стрижка</span>
          <h3>Уход, который подходит именно вам</h3>
          <p>Определим особенности волос и подберём базовые средства для ежедневного ухода и укладки.</p>
          <div class="quiz-aside-list">
            <span><i>1</i> Тип и особенности волос</span>
            <span><i>2</i> Подходящие средства</span>
            <span><i>3</i> Личный план в подарок</span>
          </div>
        </div>
        <div class="quiz-aside-foot">Здоровый вид начинается с ухода.</div>
      </aside>
      <div class="quiz-main">
        <div class="quiz-stage" id="quizStage">
          <div class="quiz-progress-head">
            <span class="quiz-progress-label">Путь к подарку</span>
            <span class="quiz-progress-count" id="quizCount">Шаг 1 из 6</span>
          </div>
          <div class="quiz-slider-row" id="quizSliderRow">
            <div class="quiz-slider" role="progressbar" aria-label="Прогресс до получения подарка" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="quizProgress">
              <div class="quiz-slider-track"><span class="quiz-slider-fill" id="quizProgressFill"></span></div>
              <span class="quiz-slider-thumb" id="quizThumb"><b class="quiz-slider-pct" id="quizPct">0%</b></span>
            </div>
            <span class="quiz-slider-gift" aria-hidden="true"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M7 20h34v22H7zM5 13h38v8H5zM24 13v29M24 13H14a5 5 0 1 1 5-5c0 3 5 5 5 5Zm0 0h10a5 5 0 1 0-5-5c0 3-5 5-5 5Z"/></svg></span>
          </div>
          <div id="quizQuestionWrap">
          <div class="quiz-question-kicker" id="quizQuestionKicker">Вопрос 1</div>
          <h3 class="quiz-question-title" id="quizQuestionTitle">Что хотите обновить?</h3>
          <p class="quiz-question-subtitle" id="quizQuestionSubtitle">Выберите вариант, который ближе всего.</p>
          <div class="quiz-choices" id="quizChoices"></div>
          <div class="quiz-actions">
            <button class="quiz-back" id="quizBack" type="button" disabled>← Назад</button>
            <button class="btn btn-gold quiz-next" id="quizNext" type="button" disabled>Далее <span aria-hidden="true">→</span></button>
          </div>
          </div>
          <form class="quiz-lead" id="quizLeadForm" novalidate>
            <div class="quiz-question-kicker">Последний шаг</div>
            <h3 class="quiz-question-title">Куда отправить ваш подарок?</h3>
            <p class="quiz-question-subtitle">Укажите данные для доступа: пришлём на почту письмо со ссылкой на сайт по уходу за волосами.</p>
            <div class="fields">
              <div class="field full" id="qfFio"><label for="qFio">ФИО</label><input id="qFio" autocomplete="name" placeholder="Иванов Иван Иванович" /><span class="err">Укажите фамилию и имя</span></div>
              <div class="field" id="qfPhone"><label for="qPhone">Телефон</label><input id="qPhone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7 (___) ___-__-__" /><span class="err">Введите номер полностью</span></div>
              <div class="field" id="qfEmail"><label for="qEmail">Email</label><input id="qEmail" type="email" inputmode="email" autocomplete="email" placeholder="name@mail.ru" /><span class="err">Проверьте адрес почты</span></div>
              <label class="check full" id="qfAgree"><input type="checkbox" id="qAgree" /><span>Согласен на обработку персональных данных для получения подарка</span></label>
              <span class="err full" id="qAgreeErr" style="grid-column:1/-1;display:none">Нужно ваше согласие</span>
            </div>
            <div class="quiz-actions">
              <button class="quiz-back" id="quizLeadBack" type="button">← Назад</button>
              <button class="btn btn-gold quiz-next" id="quizLeadSubmit" type="submit" disabled>Получить подарок <span aria-hidden="true">→</span></button>
            </div>
            <p class="quiz-lead-note" id="quizLeadNote" role="status"></p>
            <p class="quiz-lead-safe">Данные нужны только для отправки подарка. Спама не будет.</p>
          </form>
        </div>
        <div class="quiz-result" id="quizResult" aria-live="polite" aria-hidden="true">
          <div class="quiz-gift-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48"><path d="M7 20h34v22H7zM5 13h38v8H5zM24 13v29M24 13H14a5 5 0 1 1 5-5c0 3 5 5 5 5Zm0 0h10a5 5 0 1 0-5-5c0 3-5 5-5 5Z"/><path d="M13 27h6M29 27h6"/></svg>
          </div>
          <span class="eyebrow">Подарок открыт · 100%</span>
          <h3>Ваш подарок — персональный уход за волосами</h3>
          <div class="quiz-sent" id="quizSentNote" role="status"></div>
          <p>По вашим ответам мы составили базовую схему ухода: какие средства выбирать для вашего типа волос и кожи головы и как их применять.</p>
          <div class="quiz-summary" id="quizSummary"></div>
          <div class="quiz-care-plan" id="quizCarePlan"></div>
          <div class="quiz-result-actions">
            <button class="btn btn-gold" id="quizGiftButton" type="button">Получить полный подарок <span aria-hidden="true">→</span></button>
            <a class="btn btn-ghost" href="#booking">Перейти к записи</a>
          </div>
          <p class="quiz-link-note" id="quizLinkNote" role="status"></p>
          <button class="quiz-restart" id="quizRestart" type="button">Пройти квиз заново</button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- BEARD -->
<section id="beard">
  <div class="container">
    <div class="beard-split">
      <div class="reveal">
        <span class="eyebrow">Работа с бородой</span>
        <h2>Борода — это <span class="gold">архитектура</span>, а не просто подравнять</h2>
        <p class="lead">Мастер учитывает форму лица, густоту и направление роста волос. Вы видите план работы до начала и результат — до выхода из кресла.</p>
        <ul class="checks">
          <li><svg class="ico"><use href="#i-check"/></svg>Бородой занимаются мастера с профильной специализацией</li>
          <li><svg class="ico"><use href="#i-check"/></svg>Показываем форму зеркалом и обсуждаем длину по зонам</li>
          <li><svg class="ico"><use href="#i-check"/></svg>Фото до/после — вы убеждаетесь, что разница видна</li>
          <li><svg class="ico"><use href="#i-check"/></svg>Не понравилось? Исправим бесплатно в течение 7 дней</li>
        </ul>
      </div>
      <div class="photo reveal">
        <img loading="lazy" src="data:image/jpeg;base64," alt="Барбер аккуратно моделирует бороду ножницами" onerror="this.remove()" />
        <div class="badge-float"><b>5 шагов</b>от консультации до гарантии</div>
      </div>
    </div>
    <div class="steps">
      <div class="step reveal"><h4>Консультация</h4><p>5 минут: узнаём пожелания, смотрим тип волос и форму лица.</p></div>
      <div class="step reveal"><h4>Согласование</h4><p>Показываем форму и длину в зеркале. Начинаем только после вашего «да».</p></div>
      <div class="step reveal"><h4>Работа</h4><p>Машинка, ножницы, опасная бритва, горячее полотенце и уход.</p></div>
      <div class="step reveal"><h4>Фото «до / после»</h4><p>Фиксируем результат, чтобы вы видели разницу, а не верили на слово.</p></div>
      <div class="step reveal"><h4>Гарантия 7 дней</h4><p>Если что-то хочется поправить, коррекция бесплатна.</p></div>
    </div>
  </div>
</section>

