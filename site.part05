. Не наносите масла и плотные несмываемые средства на корни; мойте по мере загрязнения.',
    balanced:'Сохраняйте комфортный режим мытья. Не нужно использовать глубоко очищающий шампунь без необходимости; кондиционер наносите на длину.',
    dry:'Выбирайте мягкое очищение и тёплую, не горячую воду. Избегайте частого использования агрессивных очищающих средств; кондиционер наносите по длине.',
    sensitive:'Отдавайте предпочтение мягким средствам без выраженной отдушки и вводите новые продукты по одному. При стойком зуде, покраснении или шелушении лучше обратиться к дерматологу.'
  };
  var concernPlans={
    volume:{title:'Объём у корней',product:'Лёгкий спрей для прикорневого объёма или мусс',tip:'Наносите небольшое количество на корни влажных волос перед сушкой. Не перегружайте длину маслами и плотными кремами.'},
    dryness:{title:'Меньше сухости и ломкости',product:'Несмываемый кондиционер или увлажняющая сыворотка',tip:'Распределяйте по длине и кончикам после мытья. Увлажняющую маску можно использовать примерно раз в неделю, ориентируясь на состояние волос.'},
    frizz:{title:'Контроль пушения и гладкость',product:'Несмываемый крем или разглаживающая сыворотка',tip:'Наносите немного средства на влажную длину. Сушите без сильного трения полотенцем; для волн и кудрей выбирайте крем с подходящей маркировкой.'},
    control:{title:'Более послушная укладка',product:'Предстайлинг-спрей и паста или крем средней фиксации',tip:'Предстайлинг распределяйте по влажным волосам, а пасту или крем добавляйте понемногу на сухие или почти сухие волосы.'}
  };
  var stylingPlans={
    none:{title:'Минимальная укладка',product:'Достаточно базового ухода; стайлинг необязателен',tip:'Не покупайте средства для укладки только ради набора. Шампунь и кондиционер, подходящие вашему типу волос, могут быть всем необходимым.'},
    sometimes:{title:'Укладка время от времени',product:'Лёгкий предстайлинг или текстурирующий спрей',tip:'Используйте небольшое количество в дни укладки. При сушке феном наносите термозащиту согласно инструкции продукта.'},
    often:{title:'Регулярная укладка',product:'Термозащитный спрей и стайлинг нужной фиксации',tip:'Термозащиту наносите перед горячей укладкой. Подбирайте фиксацию под желаемую форму, а не наносите больше средства для стойкости.'},
    daily:{title:'Ежедневная укладка',product:'Термозащита и лёгкое средство для ежедневной фиксации',tip:'Старайтесь не использовать максимальную температуру фена и не перегружать волосы слоями стайлинга. Смывайте остатки средств обычным мытьём по мере необходимости.'}
  };
  var hair=hairPlans[quizSelected('hairType')]||hairPlans.normal;
  var scalp=scalpPlans[quizSelected('scalp')]||scalpPlans.balanced;
  var concern=concernPlans[quizSelected('concern')]||concernPlans.volume;
  var styling=stylingPlans[quizSelected('styling')]||stylingPlans.sometimes;
  var wash=quizSelected('washing');
  var washTip=wash==='daily'?'При ежедневном мытье выбирайте мягкий шампунь для частого применения и ориентируйтесь на состояние кожи головы.':wash==='every2'?'При мытье раз в 2–3 дня тщательно очищайте кожу головы, а кондиционер наносите на длину.':wash==='weekly'?'При редком мытье уделяйте внимание качественному очищению кожи головы и удалению остатков стайлинга.':'Частоту мытья подбирайте по загрязнению и комфорту кожи головы; строгого универсального графика нет.';
  return {
    hairType:hair.title,
    cards:[
      {label:'ШАМПУНЬ',title:hair.shampoo,detail:scalp},
      {label:'КОНДИЦИОНЕР',title:hair.conditioner,detail:hair.typeTip},
      {label:'ВАША ГЛАВНАЯ ЗАДАЧА',title:concern.product,detail:concern.tip},
      {label:'УКЛАДКА И ЗАЩИТА',title:styling.product,detail:styling.tip},
      {label:'ВАШ РЕЖИМ МЫТЬЯ',title:quizSelectedLabel('washing'),detail:washTip}
    ]
  };
}
function renderHairCarePlan(plan){
  var cards=plan.cards.map(function(card){
    return '<article class="quiz-care-card"><small>'+esc(card.label)+'</small><b>'+esc(card.title)+'</b><p>'+esc(card.detail)+'</p></article>';
  }).join('');
  return '<div class="quiz-care-plan-head"><span class="quiz-care-plan-kicker">Ваш подарок от «Стальной стрижки»</span><h4>Персональная схема ухода</h4><p class="quiz-care-plan-intro">Основа рекомендаций: '+esc(plan.hairType)+'. Подберите средство с такой маркировкой в линейке выбранного бренда.</p></div><div class="quiz-care-grid">'+cards+'</div><p class="quiz-care-footnote">Это базовая косметическая рекомендация по вашим ответам, а не диагностика. Учитывайте инструкцию производителя и индивидуальную реакцию кожи. При стойком раздражении или выпадении волос обратитесь к специалисту.</p>';
}
function quizPct(){
  var n=0;for(var i=0;i<QUIZ_QUESTIONS.length;i++){if(quizAnswers[i])n++}
  return Math.round(n/(QUIZ_QUESTIONS.length+1)*100);
}
function setQuizPct(p){
  p=Math.max(0,Math.min(100,p));
  $('#quizProgress').style.setProperty('--p',String(p/100));
  $('#quizProgress').setAttribute('aria-valuenow',String(p));
  $('#quizPct').textContent=p+'%';
  $('#quizSliderRow').classList.toggle('full',p>=100);
}
var qEmailOk=function(v){return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim())};
var qFioOk=function(v){return /^[A-Za-zА-Яа-яЁё'’.\-]{2,}(\s+[A-Za-zА-Яа-яЁё'’.\-]{2,}){1,3}$/.test(v.trim())};
function quizLeadPct(){
  var p=Math.round(QUIZ_QUESTIONS.length/(QUIZ_QUESTIONS.length+1)*100);
  if(qFioOk($('#qFio').value))p+=5;
  if(phoneOk($('#qPhone').value))p+=5;
  if(qEmailOk($('#qEmail').value))p+=5;
  return p;
}
function showQuizLead(){
  $('#quizQuestionWrap').style.display='none';
  $('#quizLeadForm').style.display='block';
  $('#quizCount').textContent='Шаг '+(QUIZ_QUESTIONS.length+1)+' из '+(QUIZ_QUESTIONS.length+1);
  setQuizPct(quizLeadPct());
  $('#qFio').focus({preventScroll:true});
}
function hideQuizLead(){
  $('#quizLeadForm').style.display='none';
  $('#quizQuestionWrap').style.display='block';
  renderQuizStep();
}
function renderQuizStep(){
  var q=QUIZ_QUESTIONS[quizStep];
  $('#quizQuestionKicker').textContent='Вопрос '+(quizStep+1);
  $('#quizQuestionTitle').textContent=q.title;
  $('#quizQuestionSubtitle').textContent=q.subtitle;
  $('#quizCount').textContent='Шаг '+(quizStep+1)+' из '+(QUIZ_QUESTIONS.length+1);
  setQuizPct(quizPct());
  $('#quizChoices').innerHTML=q.options.map(function(opt){
    var checked=quizAnswers[quizStep]===opt[0];
    return '<label class="quiz-choice"><input type="radio" name="quizAnswer" value="'+esc(opt[0])+'" '+(checked?'checked':'')+'><span class="quiz-choice-body"><span>'+esc(opt[1])+'</span><span class="quiz-choice-check" aria-hidden="true">✓</span></span></label>';
  }).join('');
  $('#quizBack').disabled=quizStep===0;
  $('#quizNext').disabled=!quizAnswers[quizStep];
  $('#quizNext').innerHTML=quizStep===QUIZ_QUESTIONS.length-1?(quizLeadDone?'Показать мой уход':'Получить подарок')+' <span aria-hidden="true">→</span>':'Далее <span aria-hidden="true">→</span>';
}
function showQuizResult(){
  $('#quizStage').style.display='none';
  var summary=QUIZ_QUESTIONS.map(function(q,i){
    var selected=q.options.filter(function(opt){return opt[0]===quizAnswers[i]})[0];
    return '<div class="quiz-summary-row"><span>'+esc(quizLabels[i])+'</span><span>'+esc(selected?selected[1]:'—')+'</span></div>';
  }).join('');
  $('#quizSummary').innerHTML='<div class="quiz-summary-title">Ваши ответы</div>'+summary;
  var plan=buildHairCarePlan();
  $('#quizCarePlan').innerHTML=renderHairCarePlan(plan);
  $('#quizResult').classList.add('show');
  $('#quizResult').setAttribute('aria-hidden','false');
  $('#quizCount').textContent='Готово';
  setQuizPct(100);
}
$('#quizChoices').addEventListener('change',function(e){
  if(e.target&&e.target.matches('input[name="quizAnswer"]')){
    quizAnswers[quizStep]=e.target.value;
    $('#quizNext').disabled=false;
    setQuizPct(quizPct());
  }
});
$('#quizNext').addEventListener('click',function(){
  if(!quizAnswers[quizStep])return;
  if(quizStep<QUIZ_QUESTIONS.length-1){quizStep++;renderQuizStep()}
  else if(quizLeadDone)showQuizResult();
  else showQuizLead();
});
$('#quizBack').addEventListener('click',function(){if(quizStep>0){quizStep--;renderQuizStep()}});
$('#quizRestart').addEventListener('click',function(){
  quizStep=0;quizAnswers=[];
  $('#quizResult').classList.remove('show');
  $('#quizResult').setAttribute('aria-hidden','true');
  $('#quizStage').style.display='block';
  $('#quizLeadForm').style.display='none';
  $('#quizQuestionWrap').style.display='block';
  $('#quizLinkNote').textContent='';
  renderQuizStep();
});
$('#quizGiftButton').addEventListener('click',function(){
  if(!QUIZ_GIFT_URL){
    $('#quizLinkNote').textContent='Ваш персональный план ухода уже сформирован выше. Ссылку на отдельную страницу с дополнительным подарком подключим, когда сайт будет готов.';
    return;
  }
  try{
    var target=new URL(QUIZ_GIFT_URL,window.location.href);
    QUIZ_QUESTIONS.forEach(function(q,i){target.searchParams.set(q.key,quizAnswers[i]||'')});
    target.searchParams.set('hairCarePlan',JSON.stringify(buildHairCarePlan()));
    window.open(target.toString(),'_blank','noopener,noreferrer');
  }catch(e){
    $('#quizLinkNote').textContent='Проверьте адрес сайта подарка в настройке QUIZ_GIFT_URL.';
  }
});
/* --- форма данных для подарка --- */
function quizLeadSync(){
  var ok=$('#qAgree').checked;
  $('#quizLeadSubmit').disabled=!ok;
  if(ok)$('#qAgreeErr').style.display='none';
  setQuizPct(quizLeadPct());
}
function quizUnlock(mode,email){
  quizLeadDone=true;
  var note=$('#quizSentNote');
  note.textContent=mode==='sent'
    ?'Письмо со ссылкой на сайт-подарок отправлено на '+email+'. Если его нет во входящих, загляните в «Спам».'
    :'Данные сохранены. Письмо с доступом придёт, как только на сайте подключат отправку почты.';
  $('#quizLeadForm').style.display='none';
  showQuizResult();
  $('#quizResult').scrollIntoView({behavior:'smooth',block:'start'});
}
function submitQuizLead(e){
  e.preventDefault();
  var fio=$('#qFio').value.trim(),phone=$('#qPhone').value,email=$('#qEmail').value.trim();
  var bad={fio:!qFioOk(fio),phone:!phoneOk(phone),email:!qEmailOk(email),agree:!$('#qAgree').checked};
  $('#qfFio').classList.toggle('invalid',bad.fio);
  $('#qfPhone').classList.toggle('invalid',bad.phone);
  $('#qfEmail').classList.toggle('invalid',bad.email);
  $('#qAgreeErr').style.display=bad.agree?'block':'none';
  if(bad.fio||bad.phone||bad.email||bad.agree){
    $('#quizLeadNote').className='quiz-lead-note bad';
    $('#quizLeadNote').textContent='Проверьте выделенные поля.';
    return;
  }
  var answers={};QUIZ_QUESTIONS.forEach(function(q,i){answers[q.key]=quizAnswers[i]||''});
  var payload={fio:fio,phone:phone,email:email,consent:true,answers:answers,plan:buildHairCarePlan(),giftUrl:QUIZ_GIFT_URL,createdAt:new Date().toISOString()};
  var btn=$('#quizLeadSubmit');
  btn.disabled=true;btn.firstChild.textContent='Отправляем… ';
  $('#quizLeadNote').className='quiz-lead-note';$('#quizLeadNote').textContent='';
  var saveLocal=function(){var all=store('sc_quiz_leads')||[];all.push({fio:fio,phone:phone,email:email,createdAt:payload.createdAt});store('sc_quiz_leads',all)};
  if(!QUIZ_LEAD_ENDPOINT){
    saveLocal();btn.firstChild.textContent='Получить подарок ';quizLeadSync();
    quizUnlock('local',email);return;
  }
  fetch(QUIZ_LEAD_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)})
    .then(function(r){if(!r.ok)throw new Error('http '+r.status);saveLocal();btn.firstChild.textContent='Получить подарок ';quizLeadSync();quizUnlock('sent',email)})
    .catch(function(){
      btn.firstChild.textContent='Получить подарок ';quizLeadSync();
      $('#quizLeadNote').className='quiz-lead-note bad';
      $('#quizLeadNote').textContent='Не удалось отправить письмо. Проверьте адрес почты и попробуйте ещё раз.';
    });
}
$('#quizLeadForm').addEventListener('submit',submitQuizLead);
$('#quizLeadBack').addEventListener('click',hideQuizLead);
$('#qAgree').addEventListener('change',quizLeadSync);
['qFio','qPhone','qEmail'].forEach(function(id){$('#'+id).addEventListener('input',function(){
  var f={qFio:'#qfFio',qPhone:'#qfPhone',qEmail:'#qfEmail'}[id];$(f).classList.remove('invalid');quizLeadSync();
})});
renderQuizStep();
function mask(inp){
  inp.addEventListener('input',function(){
    var d=inp.value.replace(/\D/g,'');
    if(d[0]==='8'||d[0]==='7')d=d.slice(1);
    d=d.slice(0,10);
    var r='+7';
    if(d.length)r+=' ('+d.slice(0,3);
    if(d.length>=3)r+=')';
    if(d.length>3)r+=' '+d.slice(3,6);
    if(d.length>6)r+='-'+d.slice(6,8);
    if(d.length>8)r+='-'+d.slice(8,10);
    inp.value=d.length?r:'';
  });
}
var phoneOk = function(v){return v.replace(/\D/g,'').length===11};
mask($('#qPhone'));

/* ===== Предложение −50%: только при первом заходе на сайт ===== */
var OFFER_MS=3*3600*1000,OFFER_END=0;
var FIRST_ELIGIBLE=(function(){
  var ok=false;
  try{
    if(store('sc_seen')===null&&!store('sc_used')){store('sc_seen',Date.now());store('sc_end',Date.now()+OFFER_MS);sessionStorage.setItem('sc_first','1')}
    ok=sessionStorage.getItem('sc_first')==='1'&&!store('sc_used');
    OFFER_END=store('sc_end')||0;
  }catch(e){}
  if(!OFFER_END)OFFER_END=Date.now()+OFFER_MS;
  return ok&&Date.now()<OFFER_END;
})();
function applyEligibility(){
  $$('.first-only').forEach(function(el){el.style.display=FIRST_ELIGIBLE?'':'none'});
  if(!FIRST_ELIGIBLE)$('#first').checked=false;
}
applyEligibility();

/* ===== Шапка, меню, статус ===== */
var header=$('#header');
function onScroll(){header.classList.toggle('scrolled',window.scrollY>30)}
window.addEventListener('scroll',onScroll,{passive:true});onScroll();
var burger=$('#burger'),menu=$('#menu');
burger.addEventListener('click',function(){var o=menu.classList.toggle('open');burger.setAttribute('aria-expanded',o);burger.textContent=o?'✕':'☰'});
$$('#menu a').forEach(function(a){a.addEventListener('click',function(){menu.classList.remove('open');burger.textContent='☰'})});
$('#year').textContent=new Date().getFullYear();

function updateStatus(){
  var n=new Date(),m=n.getHours()*60+n.getMinutes(),open=m>=OPEN*60&&m<CLOSE*60;
  var el=$('#status'),dot=$('.dot',el);
  dot.classList.toggle('off',!open);
  $('#statusText').textContent=open?('Открыто сейчас · до 22:00'+(m<=LAST_START*60?' · есть запись на сегодня':'')):'Сейчас закрыто · запись онлайн открыта 24/7';
}
updateStatus();setInterval(updateStatus,60000);

/* ===== Reveal ===== */
if('IntersectionObserver' in window){
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12});
  $$('.reveal').forEach(function(el){io.observe(el)});
}else{$$('.reveal').forEach(function(el){el.classList.add('in')})}

/* ===== Прайс ===== */
var curCat='cut';
function renderTabs(){
  $('#tabs').innerHTML=CATS.map(function(c){return '<button class="tab'+(c.id===curCat?' active':'')+'" role="tab" aria-selected="'+(c.id===curCat)+'" data-c="'+c.id+'">'+c.name+'</button>'}).join('');
  $$('#tabs .tab').forEach(function(b){b.addEventListener('click',function(){curCat=b.dataset.c;renderTabs();renderPrices()})});
}
function renderPrices(){
  $('#priceList').innerHTML=SERVICES.filter(function(s){return s.cat===curCat}).map(function(s){
    return '<div class="pr"><h4>'+esc(s.name)+'</h4><div class="price">'+fmt(s.price)+'</div><p>'+esc(s.desc)+'</p><div class="dur"><svg class="ico"><use href="#i-clock"/></svg>'+durText(s.dur)+'</div></div>';
  }).join('');
}
renderTabs();renderPrices();

var PH={m3:{c:'data:image/jpeg;base64,',f:'data:image/jpeg;base64,'},m2:{c:'data:image/jpeg;base64,',f:'data:image/jpeg;base64,'},m1:{c:'data:image/jpeg;base64,',f:'data:image/jpeg;base64,'},m5:{c:'data:image/jpeg;base64,
