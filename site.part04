];
var SERVICES = [
  {id:'c1', cat:'cut', name:'Мужская стрижка', price:1800, dur:60, desc:'Консультация, стрижка ножницами и/или машинкой, мытьё головы, укладка.'},
  {id:'c2', cat:'cut', name:'Стрижка машинкой', price:1200, dur:40, desc:'Одна или две насадки, окантовка, мытьё головы.'},
