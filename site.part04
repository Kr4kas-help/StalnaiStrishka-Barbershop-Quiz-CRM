  {id:'b1', cat:'beard', name:'Моделирование бороды', price:1300, dur:40, desc:'Согласование формы, стрижка, окантовка, горячее полотенце, масло.'},
  {id:'b2', cat:'beard', name:'Королевское бритьё', price:1500, dur:45, desc:'Опасная бритва, распаривание, горячее и холодное полотенце, уход.'},
  {id:'b3', cat:'beard', name:'Оформление усов', price:500, dur:15, desc:'Форма и длина, окантовка.'},
