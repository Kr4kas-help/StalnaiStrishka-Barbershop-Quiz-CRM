<script>
(function(){
'use strict';

/* ===== Конфигурация (меняйте под себя) ===== */
var OPEN = 10, CLOSE = 22, LAST_START = 21, STEP = 30, DAYS_AHEAD = 14, FIRST_DISCOUNT = 0.5;

var CATS = [
