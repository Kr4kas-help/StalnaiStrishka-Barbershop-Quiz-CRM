/* ===== Мастера ===== */
$('#mastersGrid').innerHTML=MASTERS.map(function(m){
  return '<article class="master reveal"><div class="mphoto"><img src="'+PH[m.id].c+'" alt="'+esc(m.name)+', мастер" loading="lazy"></div><h3>'+esc(m.name)+'</h3><div class="role">'+esc(m.role)+' · '+esc(m.exp)+'</div><p>'+esc(m.bio)+'</p><div class="chips">'+m.tags.map(function(t){return '<span class="chip'+(t==='Борода'?' beard':'')+'">'+esc(t)+'</span>'}).join('')+'</div><button type="button" class="btn btn-ghost btn-sm" data-pick="'+m.id+'">Записаться к мастеру</button></article>';
}).join('');
$$('#mastersGrid .reveal').forEach(function(el){if(typeof io!=='undefined')io.observe(el);else el.classList.add('in')});
$$('[data-pick]').forEach(function(b){b.addEventListener('click',function(){
  var r=$('input[name="master"][value="'+b.dataset.pick+'"]');if(r){r.checked=true;state.master=b.dataset.pick;renderSlots();renderSummary()}
  $('#booking').scrollIntoView({behavior:'smooth'});
})});

/* ===== Запись ===== */
var state={services:[],master:'any',date:null,time:null};
var bookings=store('bc_bookings')||[];

$('#svcPick').innerHTML=CATS.map(function(c){
  return '<div class="svc-group"><small>'+c.name+'</small><div class="svc-opts">'+SERVICES.filter(function(s){return s.cat===c.id}).map(function(s){
    return '<label class="opt"><input type="checkbox" name="svc" value="'+s.id+'"><span>'+esc(s.name)+' <b>'+fmt(s.price)+'</b></span></label>';
  }).join('')+'</div></div>';
}).join('');
