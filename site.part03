" alt="Пять мастеров барбершопа в профессиональной команде" width="1672" height="941" loading="lazy" decoding="async" />
    </figure>
    <div class="grid5" id="mastersGrid"></div>
  </div>
</section>

<!-- BOOKING -->
<section id="booking">
  <div class="container">
    <div class="sec-head center reveal">
      <span class="eyebrow">Онлайн-запись</span>
      <h2>Запишитесь за минуту</h2>
      <p class="lead">Свободное время обновляется в реальном времени. Звонить не нужно, подтверждение приходит сразу.</p>
    </div>
    <form class="book-grid" id="bookForm" novalidate>
      <div class="panel">
        <div class="fs">
          <div class="fs-title"><i>1</i>Что делаем?</div>
          <div id="svcPick"></div>
        </div>
        <div class="fs">
          <div class="fs-title"><i>2</i>К какому мастеру?</div>
          <div class="mgrid" id="masterPick"></div>
        </div>
        <div class="fs">
          <div class="fs-title"><i>3</i>Дата</div>
          <div class="days" id="days"></div>
        </div>
        <div class="fs">
          <div class="fs-title"><i>4</i>Время</div>
          <div class="slots" id="slots"></div>
          <p class="hint" id="slotHint">Сначала выберите услугу и дату.</p>
        </div>
        <div class="fs">
          <div class="fs-title"><i>5</i>Контакты</div>
          <div class="fields">
            <div class="field" id="fName"><label for="name">Ваше имя</label><input id="name" autocomplete="name" placeholder="Иван" /><span class="err">Укажите имя</span></div>
            <div class="field" id="fPhone"><label for="phone">Телефон</label><input id="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7 (___) ___-__-__" /><span class="err">Введите номер полностью</span></div>
            <div class="field full"><label for="comment">Пожелания (необязательно)</label><textarea id="comment" placeholder="Например: хочу fade с переходом на бороду, чувствительная кожа…"></textarea></div>
            <label class="check full first-only" id="firstWrap"><input type="checkbox" id="first" checked /><span>Я впервые на сайте — скидка 50% на любую услугу</span></label>
            <label class="check full" id="fAgree"><input type="checkbox" id="agree" /><span>Согласен на обработку персональных данных для записи</span></label>
            <span class="err full" id="agreeErr" style="grid-column:1/-1;color:var(--err);font-size:12px;display:none">Нужно ваше согласие</span>
          </div>
        </div>
      </div>

      <aside class="panel summary">
        <h3 style="margin-bottom:10px">Ваша запись</h3>
        <div id="sumBody"></div>
        <div class="promise"><b>Гарантия цены:</b> итог на кассе не будет выше суммы выше. Скидка за первый визит применяется ко всем услугам, включая комплексы.</div>
        <button type="submit" class="btn btn-gold" style="width:100%" id="submitBtn" disabled>Подтвердить запись</button>
        <p class="hint warn" id="agreeHint" style="text-align:center">Отметьте согласие на обработку персональных данных — без него запись недоступна.</p>
        <p class="hint" style="text-align:center">Отмена и перенос — бесплатно, за 2 часа до визита.</p>
      </aside>
    </form>
    <div class="mybook" id="mybook" style="display:none">
      <h3>Мои записи</h3>
      <div id="bkList"></div>
    </div>
  </div>
</section>

<!-- PROMO -->
<section style="padding-top:0" class="first-only">
  <div class="container">
    <div class="promo reveal" id="promo">
      <div class="big">−50%</div>
      <div>
        <span class="eyebrow">Акция</span>
        <h2 style="margin:12px 0 6px">Первый визит — со скидкой</h2>
        <ul>
          <li><svg class="ico"><use href="#i-check"/></svg>Действует на любую услугу и на комплексы</li>
          <li><svg class="ico"><use href="#i-check"/></svg>Без минимальной суммы и скрытых исключений</li>
          <li><svg class="ico"><use href="#i-check"/></svg>Считается автоматически при онлайн-записи и на кассе</li>
          <li><svg class="ico"><use href="#i-check"/></svg>Единственное условие — вы впервые на сайте</li>
        </ul>
        <p class="promo-timer">Акция ограничена. До конца: <b data-tline>03:00:00</b></p>
      </div>
      <a href="#booking" class="btn btn-gold">Получить скидку</a>
    </div>
  </div>
</section>

<!-- GALLERY -->
