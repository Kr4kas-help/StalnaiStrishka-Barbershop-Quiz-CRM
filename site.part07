'
};
$('#masterPick').innerHTML='<label class="mopt"><input type="radio" name="master" value="any" checked><span><div class="mini">★</div>Любой свободный</span></label>'+MASTERS.map(function(m){
  return '<label class="mopt"><input type="radio" name="master" value="'+m.id+'"><span><div class="mini"><img src="'+MASTER_PICKER_PHOTOS[m.id]+'" alt="" loading="lazy"></div>'+m.name.split(' ')[0]+(m.beard?'<small style="color:var(--gold)">борода</small>':'<small style="color:var(--muted)">'+esc(m.tags[0].toLowerCase())+'</small>')+'</span></label>';
}).join('');

/* дни */
var today=new Date();today.setHours(0,0,0,0);
var days=[];for(var i=0;i<DAYS_AHEAD;i++){var d=new Date(today);d.setDate(d.getDate()+i);days.push(d)}
var WD=['Вс','Пн','Вт','Ср','Чт','Пт','Сб'];
function renderDays(){
  $('#days').innerHTML=days.map(function(d,i){
    var lab=i===0?'Сегодня':i===1?'Завтра':WD[d.getDay()];
    return '<button type="button" class="day'+(state.date===dkey(d)?' active':'')+'" data-d="'+dkey(d)+'"><small>'+lab+'</small><b>'+d.getDate()+'</b><small>'+['янв','фев','мар','апр','мая','июн','июл','авг','сен','окт','ноя','дек'][d.getMonth()]+'</small></button>';
  }).join('');
  $$('#days .day').forEach(function(b){b.addEventListener('click',function(){state.date=b.dataset.d;state.time=null;renderDays();renderSlots();renderSummary()})});
}
state.date=dkey(days[0]);

function totals(){
  var sel=SERVICES.filter(function(s){return state.services.indexOf(s.id)>-1});
  var sum=sel.reduce(function(a,s){return a+s.price},0),dur=sel.reduce(function(a,s){return a+s.dur},0);
  var disc=($('#first').checked&&FIRST_ELIGIBLE)?Math.round(sum*FIRST_DISCOUNT):0;
  return {sel:sel,sum:sum,dur:dur,disc:disc,total:sum-disc};
}
function busySeed(date,mid,t){return hash(date+'|'+mid+'|'+t)%100<28}
function userBusy(date,mid,t0,t1){
  return bookings.some(function(b){return b.date===date&&b.master===mid&&t0<b.start+b.dur&&t1>b.start});
}
function masterFree(date,mid,start,dur){
  for(var t=start;t<start+dur;t+=STEP){ if(t<CLOSE*60&&busySeed(date,mid,t))return false }
  return !userBusy(date,mid,start,start+dur);
}
function freeMasters(date,start,dur){
  var list=state.master==='any'?MASTERS.map(function(m){return m.id}):[state.master];
  return list.filter(function(id){return masterFree(date,id,start,dur)});
}
function renderSlots(){
  var box=$('#slots'),hint=$('#slotHint'),t=totals();
  if(!t.sel.length){box.innerHTML='';hint.className='hint';hint.textContent='Сначала выберите услугу, чтобы мы показали подходящие окна.';return}
  var now=new Date(),isToday=state.date===dkey(now),nowM=now.getHours()*60+now.getMinutes()+30;
  var html='',free=0;
  for(var m=OPEN*60;m<=LAST_START*60;m+=STEP){
    var ok=!(isToday&&m<nowM)&&freeMasters(state.date,m,t.dur).length>0;
    if(ok)free++;
    html+='<button type="button" class="slot'+(state.time===m?' active':'')+'" data-t="'+m+'"'+(ok?'':' disabled')+'>'+tm(m)+'</button>';
  }
  box.innerHTML=html;
  if(state.time!==null&&!$('.slot[data-t="'+state.time+'"]:not([disabled])',box))state.time=null;
  $$('.slot',box).forEach(function(b){b.addEventListener('click',function(){state.time=+b.dataset.t;renderSlots();renderSummary()})});
  if(free===0){hint.className='hint warn';hint.textContent='На этот день свободных окон нет. Выберите другую дату или другого мастера.'}
  else{hint.className='hint';hint.textContent='Длительность: '+durText(t.dur)+'. Свободных окон: '+free+'. Зачёркнутое время занято.'}
}
function renderSummary(){
  var t=totals(),b=$('#sumBody'),h='';
  if(!t.sel.length){h='<div class="sum-empty">Выберите услуги слева — здесь появится расчёт.</div>'}
  else{
    h=t.sel.map(function(s){return '<div class="sum-row"><span>'+esc(s.name)+'</span><span>'+fmt(s.price)+'</span></div>'}).join('');
    h+='<div class="sum-row muted"><span>Длительность</span><span>'+durText(t.dur)+'</span></div>';
    if(t.disc)h+='<div class="sum-row disc"><span>Скидка за первый визит −50%</span><span>−'+fmt(t.disc)+'</span></div>';
    h+='<div class="sum-total"><span>Итого</span><b>'+fmt(t.total)+'</b></div>';
  }
  var mm=state.master==='any'?'Любой свободный':MASTERS.filter(function(m){return m.id===state.master})[0].name;
  var dd=days.filter(function(d){return dkey(d)===state.date})[0];
  h+='<div class="sum-row muted"><span>Мастер</span><span>'+esc(mm)+'</span></div>';
  h+='<div class="sum-row muted"><span>Когда</span><span>'+(dd?dd.getDate()+'.'+pad(dd.getMonth()+1):'—')+(state.time!==null?' в '+tm(state.time):'')+'</span></div>';
  b.innerHTML=h;
}
$('#svcPick').addEventListener('change',function(){
  state.services=$$('input[name="svc"]:checked').map(function(i){return i.value});
  renderSlots();renderSummary();
});
$('#masterPick').addEventListener('change',function(e){state.master=e.target.value;renderSlots();renderSummary()});
$('#first').addEventListener('change',renderSummary);
mask($('#phone'));mask($('#cbPhone'));
renderDays();renderSlots();renderSummary();

function myBookingsRender(){
  var box=$('#mybook'),list=$('#bkList');
  var upcoming=bookings.filter(function(b){return true});
  box.style.display=upcoming.length?'block':'none';
  list.innerHTML=upcoming.map(function(b){
    var p=b.date.split('-');
    return '<div class="bk"><div><b>'+p[2]+'.'+p[1]+' в '+tm(b.start)+' · '+esc(b.masterName)+'</b><small>'+esc(b.services.join(', '))+' · '+fmt(b.total)+'</small></div><button type="button" class="x" data-id="'+b.id+'">Отменить</button></div>';
  }).join('');
  $$('.x',list).forEach(function(x){x.addEventListener('click',function(){
    bookings=bookings.filter(function(b){return b.id!==x.dataset.id});
    store('bc_bookings',bookings);myBookingsRender();renderSlots();toast('Запись отменена. Окно снова свободно.');
  })});
}
myBookingsRender();

var lastBk=null;
function setInvalid(id,bad){$(id).classList.toggle('invalid',bad)}
$('#bookForm').addEventListener('submit',function(e){
  e.preventDefault();
  if(!$('#agree').checked){syncAgree();$('#agreeErr').style.display='block';toast('Отметьте согласие на обработку персональных данных');$('#agree').focus();return}
  var t=totals(),bad=false;
  var nameBad=$('#name').value.trim().length<2,phBad=!phoneOk($('#phone').value);
  setInvalid('#fName',nameBad);setInvalid('#fPhone',phBad);
  var agreeBad=!$('#agree').checked;$('#agreeErr').style.display=agreeBad?'block':'none';
  if(!t.sel.length){toast('Выберите хотя бы одну услугу');$('#svcPick').scrollIntoView({behavior:'smooth',block:'center'});return}
  if(state.time===null){toast('Выберите время визита');$('#slots').scrollIntoView({behavior:'smooth',block:'center'});return}
  if(nameBad||phBad||agreeBad){toast('Проверьте контактные данные');return}
  var free=freeMasters(state.date,state.time,t.dur);
  if(!free.length){toast('Это время только что заняли. Выберите другое.');renderSlots();return}
  var mid=free[0],mobj=MASTERS.filter(function(m){return m.id===mid})[0];
  var bk={id:String(Date.now()),date:state.date,start:state.time,dur:t.dur,master:mid,masterName:mobj.name,services:t.sel.map(function(s){return s.name}),total:t.total,name:$('#name').value.trim(),phone:$('#phone').value};
  bookings.push(bk);store('bc_bookings',bookings);lastBk=bk;
  if(t.disc>0){store('sc_used',1);FIRST_ELIGIBLE=false;applyEligibility()}
  var p=bk.date.split('-');
  $('#mBox').innerHTML='<div><span>Дата</span><b>'+p[2]+'.'+p[1]+'.'+p[0]+', '+tm(bk.start)+'</b></div><div><span>Мастер</span><b>'+esc(bk.masterName)+'</b></div><div><span>Услуги</span><b style="text-align:right">'+esc(bk.services.join(', '))+'</b></div><div><span>К оплате</span><b class="gold">'+fmt(bk.total)+'</b></div>';
  $('#modal').classList.add('show');
  state.time=null;myBookingsRender();renderSlots();renderSummary();
});
['name','phone'].forEach(function(id){$('#'+id).addEventListener('input',function(){setInvalid(id==='name'?'#fName':'#fPhone',false)})});
function syncAgree(){var ok=$('#agree').checked;$('#submitBtn').disabled=!ok;$('#agreeHint').style.display=ok?'none':'block';if(ok)$('#agreeErr').style.display='none'}
$('#agree').addEventListener('change',syncAgree);syncAgree();
function closeModal(){$('#modal').classList.remove('show')}
$('#mClose').addEventListener('click',closeModal);
$('#modal').addEventListener('click',function(e){if(e.target.id==='modal')closeModal()});
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeModal()});
$('#icsBtn').addEventListener('click',function(){
  if(!lastBk)return;
  var p=lastBk.date.split('-'),s=p[0]+p[1]+p[2]+'T'+pad(Math.floor(lastBk.start/60))+pad(lastBk.start%60)+'00';
  var en=lastBk.start+lastBk.dur,e=p[0]+p[1]+p[2]+'T'+pad(Math.floor(en/60))+pad(en%60)+'00';
  var ics=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Stalnaya Strizhka//RU','BEGIN:VEVENT','UID:'+lastBk.id+'@stalnaya-strizhka','DTSTAMP:'+s,'DTSTART:'+s,'DTEND:'+e,'SUMMARY:Стальная Стрижка — '+lastBk.services.join(', '),'LOCATION:Химки\\, пр-т Мельникова\\, 1','DESCRIPTION:Мастер: '+lastBk.masterName,'END:VEVENT','END:VCALENDAR'].join('\r\n');
  var a=document.createElement('a');a.href=URL.createObjectURL(new Blob([ics],{type:'text/calendar'}));a.download='barbershop-visit.ics';document.body.appendChild(a);a.click();a.remove();
});

/* ===== Перезвонить ===== */
$('#cbForm').addEventListener('submit',function(e){
  e.preventDefault();
  var nb=$('#cbName').value.trim().length<2,pb=!phoneOk($('#cbPhone').value);
  setInvalid('#cbN',nb);setInvalid('#cbP',pb);
  if(nb||pb)return;
  $('#cbForm').reset();toast('Спасибо! Перезвоним в течение 15 минут (в рабочее время).');
});

/* ===== Отзывы ===== */
var userRevs=store('bc_reviews')||[];
function stars(n){return '★★★★★'.slice(0,n)+'<span style="opacity:.25">'+'★★★★★'.slice(0,5-n)+'</span>'}
function renderRevs(){
  var all=userRevs.concat(SEED_REVIEWS);
  $('#revList').innerHTML=all.map(function(r){
    return '<div class="rev"><div class="rev-top"><b>'+esc(r.n)+'</b><span class="stars" aria-label="Оценка '+r.s+' из 5">'+stars(r.s)+'</span></div><p>'+esc(r.t)+'</p>'+(r.r?'<div class="reply"><b>Ответ барбершопа:</b> '+esc(r.r)+'</div>':'')+'<small>'+esc(r.d)+'</small></div>';
  }).join('');
}
renderRevs();
$('#revForm').addEventListener('submit',function(e){
  e.preventDefault();
  var nb=$('#rn').value.trim().length<2,tb=$('#rt').value.trim().length<5;
  setInvalid('#rName',nb);setInvalid('#rText',tb);
  if(nb||tb)return;
  var st=+$('input[name="st"]:checked').value;
  var dt=new Date();
  userRevs.unshift({n:$('#rn').value.trim(),s:st,t:$('#rt').value.trim(),d:dt.toLocaleDateString('ru-RU'),r:st<=3?'Нам жаль, что так вышло. Управляющий свяжется с вами в течение 30 минут: исправим результат или вернём деньги.':null});
  store('bc_reviews',userRevs);renderRevs();$('#revForm').reset();toast('Спасибо за отзыв!');
});

/* ===== FAQ ===== */
$('#faqList').innerHTML=FAQ.map(function(f,i){
  return '<div class="q"><button type="button" aria-expanded="false" aria-controls="a'+i+'">'+esc(f[0])+'<span class="pl"><svg class="ico" style="font-size:16px" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span></button><div class="a" id="a'+i+'"><p>'+esc(f[1])+'</p></div></div>';
}).join('');
$$('.q button').forEach(function(b){b.addEventListener('click',function(){
  var q=b.parentNode,a=$('.a',q),open=q.classList.toggle('open');
  b.setAttribute('aria-expanded',open);
  a.style.maxHeight=open?a.scrollHeight+'px':'0';
})});

/* ===== Таймер акции: 3 часа с первого захода ===== */
function fillTimer(){
  var left=Math.max(0,OFFER_END-Date.now()),h=Math.floor(left/3600000),m=Math.floor(left%3600000/60000),sc=Math.floor(left%60000/1000);
  $$('[data-t="h"]').forEach(function(e){e.textContent=pad(h)});
  $$('[data-t="m"]').forEach(function(e){e.textContent=pad(m)});
  $$('[data-t="s"]').forEach(function(e){e.textContent=pad(sc)});
  $$('[data-tline]').forEach(function(e){e.textContent=pad(h)+':'+pad(m)+':'+pad(sc)});
}
fillTimer();
setInterval(function(){
  fillTimer();
  if(FIRST_ELIGIBLE&&OFFER_END-Date.now()<=0){
    FIRST_ELIGIBLE=false;applyEligibility();renderSlots();renderSummary();
    $('#exitPop').classList.remove('show');toast('Время акции −50% истекло');
  }
},1000);

/* ===== Exit-intent: −50% новому гостю (один показ за визит) ===== */
(function(){
  var pop=$('#exitPop'),shown=false,t0=Date.now();
  try{shown=sessionStorage.getItem('sc_exit')==='1'}catch(e){}
  function openPop(){
    if(shown||!FIRST_ELIGIBLE||$('#modal').classList.contains('show'))return;
    shown=true;try{sessionStorage.setItem('sc_exit','1')}catch(e){}
    pop.classList.add('show');$('#exTake').focus();
  }
  function closePop(){pop.classList.remove('show')}
  if(!shown&&FIRST_ELIGIBLE){
    document.addEventListener('mouseout',function(e){
      if(e.relatedTarget===null&&e.clientY<=0&&Date.now()-t0>4000)openPop();
    });
    if(('ontouchstart' in window)||navigator.maxTouchPoints>0)setTimeout(openPop,25000);
  }
  $('#exTake').addEventListener('click',function(){
    $('#first').checked=true;renderSlots();renderSummary();closePop();
    toast('Скидка 50% активирована — выберите услугу и время.');
  });
  $('#exSkip').addEventListener('click',closePop);
  $('#exClose').addEventListener('click',closePop);
  pop.addEventListener('click',function(e){if(e.target===pop)closePop()});
  document.addEventListener('keydown',function(e){if(e.key==='Escape')closePop()});
})();

})();
</script>
</body>
</html>

