<!doctype html>
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Стальная Стрижка — барбершоп в Химках · онлайн-запись, прозрачные цены</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2064%2064'%3E%3Crect%20width='64'%20height='64'%20rx='14'%20fill='%230b0a09'/%3E%3Crect%20x='2'%20y='2'%20width='60'%20height='60'%20rx='12'%20fill='none'%20stroke='%23c9a45c'%20stroke-opacity='.5'%20stroke-width='2'/%3E%3Cg%20transform='translate%288%208%29%20scale%281.2%29'%3E%3Cpath%20fill='%23e6c984'%20fill-rule='evenodd'%20d='M6%208C6%208%208%2011%2012%2011C50%2011%2017%209.5%2020%209.5C23%209.5%2025%2011%2028%2011C32%2011%2034%208%2034%208C35.5%2018%2033%2027%2026%2033C23%2035.5%2021.5%2037%2020%2037C18.5%2037%2017%2035.5%2014%2033C7%2027%204.5%2018%206%208Z%20M14%2020C16.5%2018%2018%2019%2020%2019C22%2019%2023.5%2018%2026%2020C24%2023.5%2022%2024%2020%2024C18%2024%2016%2023.5%2014%2020Z'/%3E%3C/g%3E%3C/svg%3E" />
<link rel="shortcut icon" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2064%2064'%3E%3Crect%20width='64'%20height='64'%20rx='14'%20fill='%230b0a09'/%3E%3Crect%20x='2'%20y='2'%20width='60'%20height='60'%20rx='12'%20fill='none'%20stroke='%23c9a45c'%20stroke-opacity='.5'%20stroke-width='2'/%3E%3Cg%20transform='translate%288%208%29%20scale%281.2%29'%3E%3Cpath%20fill='%23e6c984'%20fill-rule='evenodd'%20d='M6%208C6%208%208%2011%2012%2011C50%2011%2017%209.5%2020%209.5C23%209.5%2025%2011%2028%2011C32%2011%2034%208%2034%208C35.5%2018%2033%2027%2026%2033C23%2035.5%2021.5%2037%2020%2037C18.5%2037%2017%2035.5%2014%2033C7%2027%204.5%2018%206%208Z%20M14%2020C16.5%2018%2018%2019%2020%2019C22%2019%2023.5%2018%2026%2020C24%2023.5%2022%2024%2020%2024C18%2024%2016%2023.5%2014%2020Z'/%3E%3C/g%3E%3C/svg%3E" />
<meta name="description" content="Барбершоп в Химках: стрижки, борода, королевское бритьё. Мытьё головы входит в каждую услугу, цены без звёздочек, онлайн-запись с живым расписанием, бесплатная коррекция 7 дней." />
<meta name="theme-color" content="#0b0a09" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@500;600;700;800&display=swap" rel="stylesheet" />

<style>
:root{
  --bg:#0b0a09;
  --bg2:#12100e;
  --card:#181512;
  --card2:#1f1b17;
  --line:rgba(231,208,160,.14);
  --line2:rgba(231,208,160,.28);
  --gold:#c9a45c;
  --gold2:#e6c984;
  --cream:#f2eadb;
  --muted:#a69d8d;
  --ok:#6fcf97;
  --err:#ef6b5b;
  --radius:18px;
  --serif:'Playfair Display',Georgia,'Times New Roman',serif;
  --sans:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:84px}
body{background:var(--bg);color:var(--cream);font-family:var(--sans);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer;background:none;border:0}
ul{list-style:none}
.container{width:min(1180px,100% - 40px);margin-inline:auto}
section{padding:96px 0;position:relative}
.eyebrow{display:inline-flex;align-items:center;gap:12px;font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);font-weight:600}
.eyebrow::before{content:"";width:34px;height:1px;background:var(--gold)}
h1,h2,h3{font-family:var(--serif);font-weight:600;line-height:1.12;letter-spacing:-.01em}
h2{font-size:clamp(30px,4.2vw,50px);margin:16px 0 14px}
h3{font-size:22px}
.lead{color:var(--muted);max-width:640px;font-size:17px}
.sec-head{margin-bottom:48px}
.sec-head.center{text-align:center}
.sec-head.center .lead{margin-inline:auto}
.sec-head.center .eyebrow::after{content:"";width:34px;height:1px;background:var(--gold)}
.gold{color:var(--gold2)}
.ico{width:1em;height:1em;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:none}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:15px 28px;border-radius:999px;font-weight:600;font-size:15px;letter-spacing:.02em;transition:.25s;border:1px solid transparent;white-space:nowrap}
.btn-gold{background:linear-gradient(135deg,var(--gold2),var(--gold));color:#17120a;box-shadow:0 10px 30px -10px rgba(201,164,92,.6)}
.btn-gold:hover{transform:translateY(-2px);box-shadow:0 16px 34px -10px rgba(201,164,92,.75)}
.btn-ghost{border-color:var(--line2);color:var(--cream)}
.btn-ghost:hover{border-color:var(--gold);color:var(--gold2)}
.btn-sm{padding:11px 20px;font-size:14px}
.btn[disabled]{opacity:.5;pointer-events:none}

/* header */
header{position:fixed;inset:0 0 auto 0;z-index:50;transition:.3s}
header.scrolled{background:rgba(11,10,9,.88);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;height:76px;gap:20px}
.logo{display:flex;align-items:center;gap:12px;font-family:var(--serif);font-weight:700;font-size:20px;letter-spacing:.02em}
.logo svg{width:38px;height:38px;color:var(--gold2)}
.logo small{display:block;font-family:var(--sans);font-size:9px;letter-spacing:.38em;color:var(--muted);font-weight:500;margin-top:-2px}
.menu{display:flex;gap:28px;font-size:14px;color:#d8cfbd}
.menu a{position:relative;padding:6px 0;transition:.2s}
.menu a::after{content:"";position:absolute;left:0;bottom:0;height:1px;width:0;background:var(--gold);transition:.25s}
.menu a:hover{color:var(--gold2)}
.menu a:hover::after{width:100%}
.nav-right{display:flex;align-items:center;gap:18px}
.phone{font-weight:600;font-size:15px;display:flex;align-items:center;gap:8px}
.phone .ico{color:var(--gold)}
.burger{display:none;width:44px;height:44px;border:1px solid var(--line2);border-radius:12px;align-items:center;justify-content:center;font-size:22px}

/* hero */
.hero{min-height:100svh;display:flex;align-items:center;padding:130px 0 70px;overflow:hidden;background:#0b0a09}
.hero-bg{position:absolute;inset:0;background:radial-gradient(900px 500px at 80% 20%,rgba(201,164,92,.18),transparent 60%),linear-gradient(120deg,#0b0a09,#1a1510)}
.hero-bg img{position:absolute;inset:0;width:100%;max-width:none;height:100%;object-fit:cover;object-position:center;opacity:.82;filter:brightness(.88) contrast(1.07);-webkit-mask-image:none;mask-image:none}
.hero-bg::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(11,10,9,.48) 0%,rgba(11,10,9,.26) 48%,rgba(11,10,9,.12) 100%),linear-gradient(0deg,var(--bg),transparent 28%)}
.hero .container{position:relative;z-index:2}
.hero h1{font-size:clamp(40px,6.6vw,84px);margin:22px 0 22px;max-width:900px;font-weight:700}
.hero h1 em{font-style:italic;color:var(--gold2);font-weight:500}
.hero p.lead{font-size:19px;color:#cfc5b2;margin-bottom:34px}
.hero-cta{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:56px}
.facts{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:1px solid var(--line);border-radius:var(--radius);background:rgba(18,16,14,.7);backdrop-filter:blur(10px);max-width:900px}
.fact{padding:22px 24px;border-right:1px solid var(--line)}
.fact:last-child{border:0}
.fact b{display:block;font-family:var(--serif);font-size:30px;color:var(--gold2);font-weight:600;line-height:1.1}
.fact span{font-size:13px;color:var(--muted);line-height:1.4;display:block;margin-top:6px}
.status{display:inline-flex;align-items:center;gap:10px;padding:8px 16px;border:1px solid var(--line2);border-radius:999px;font-size:13px;background:rgba(11,10,9,.6);margin-bottom:6px}
.dot{width:8px;height:8px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 4px rgba(111,207,151,.18);animation:pulse 2s infinite}
.dot.off{background:var(--err);box-shadow:0 0 0 4px rgba(239,107,91,.18);animation:none}
@keyframes pulse{50%{box-shadow:0 0 0 8px rgba(111,207,151,0)}}

/* marquee */
.marquee{border-block:1px solid var(--line);background:var(--bg2);overflow:hidden;padding:18px 0}
.marquee-track{display:flex;gap:48px;width:max-content;animation:slide 38s linear infinite;font-family:var(--serif);font-size:22px;color:var(--gold);white-space:nowrap}
.marquee-track span{display:flex;align-items:center;gap:48px}
.marquee-track span::after{content:"✦";font-size:12px;color:var(--muted)}
@keyframes slide{to{transform:translateX(-50%)}}

/* promises */
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.pcard{background:linear-gradient(180deg,var(--card2),var(--card));border:1px solid var(--line);border-radius:var(--radius);padding:32px 28px;transition:.3s;position:relative;overflow:hidden}
.pcard:hover{border-color:var(--line2);transform:translateY(-4px)}
.pimg{margin:-32px -28px 24px;height:176px;border-bottom:1px solid var(--line2);overflow:hidden;background:#15110d}
.pimg img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .6s}
.pcard:hover .pimg img{transform:scale(1.05)}
.pcard .ic{width:52px;height:52px;border-radius:14px;border:1px solid var(--line2);display:grid;place-items:center;font-size:24px;color:var(--gold2);margin-bottom:22px;background:rgba(201,164,92,.06)}
.pcard h3{margin-bottom:10px}
.pcard p{color:var(--muted);font-size:15px}
.pcard .tag{display:inline-block;margin-top:16px;font-size:12px;letter-spacing:.06em;color:var(--gold);border-top:1px solid var(--line);padding-top:12px;width:100%}

/* services */
#services{background:var(--bg2)}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px;justify-content:center}
.tab{padding:11px 24px;border-radius:999px;border:1px solid var(--line2);font-size:14px;font-weight:500;color:var(--muted);transition:.2s}
.tab:hover{color:var(--cream)}
.tab.active{background:var(--gold);border-color:var(--gold);color:#17120a;font-weight:600}
.price-wrap{display:grid;grid-template-columns:1.5fr 1fr;gap:28px;align-items:start}
.price-list{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:10px 30px}
.pr{display:grid;grid-template-columns:1fr auto;gap:6px 20px;padding:22px 0;border-bottom:1px dashed var(--line);align-items:baseline}
.pr:last-child{border:0}
.pr h4{font-family:var(--serif);font-size:20px;font-weight:600}
.pr .price{font-family:var(--serif);font-size:24px;color:var(--gold2);white-space:nowrap}
.pr p{color:var(--muted);font-size:14px}
.pr .dur{font-size:13px;color:var(--muted);text-align:right;display:flex;gap:6px;justify-content:flex-end;align-items:center}
.included{background:linear-gradient(160deg,#241d14,#15110d);border:1px solid var(--line2);border-radius:var(--radius);padding:32px;position:sticky;top:100px}
.included h3{margin-bottom:6px}
.included ul{margin:20px 0}
.included li{display:flex;gap:12px;padding:9px 0;color:#d8cfbd;font-size:15px}
.included li .ico{color:var(--ok);margin-top:5px;font-size:16px}
.note{font-size:13px;color:var(--muted);border-top:1px solid var(--line);padding-top:16px}

/* beard process */
.steps{display:grid;grid-template-columns:repeat(5,1fr);gap:18px;counter-reset:s}
.step{padding:28px 22px;border:1px solid var(--line);border-radius:var(--radius);background:var(--card);position:relative;counter-increment:s}
.step::before{content:"0" counter(s);font-family:var(--serif);font-size:44px;color:rgba(201,164,92,.35);display:block;line-height:1;margin-bottom:16px}
.step h4{font-family:var(--serif);font-size:19px;margin-bottom:8px}
.step p{color:var(--muted);font-size:14px}
.beard-split{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;margin-bottom:56px}
.photo{border-radius:var(--radius);overflow:hidden;position:relative;aspect-ratio:4/3;background:linear-gradient(135deg,#2a2218,#15110d);border:1px solid var(--line)}
.photo img{width:100%;height:100%;object-fit:cover;transition:.6s}
.photo:hover img{transform:scale(1.05)}
.badge-float{position:absolute;left:18px;bottom:18px;background:rgba(11,10,9,.85);backdrop-filter:blur(8px);border:1px solid var(--line2);padding:12px 18px;border-radius:14px;font-size:13px}
.badge-float b{color:var(--gold2);font-family:var(--serif);font-size:18px;display:block}
.checks li{display:flex;gap:12px;margin:14px 0;color:#d8cfbd}
.checks .ico{color:var(--gold);margin-top:5px}

/* masters */
#masters{background:var(--bg2);padding:68px 0 72px}
#masters .sec-head{margin-bottom:28px}
.masters-team-banner{width:min(100%,1000px);margin:0 auto 24px;overflow:hidden;border:1px solid var(--line2);border-radius:var(--radius);background:#15110d;box-shadow:0 18px 48px rgba(0,0,0,.32)}
.masters-team-banner img{display:block;width:100%;height:auto}
.grid5{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px;align-items:stretch}
.grid5>*{grid-column:auto;min-width:0}
.master{border:1px solid var(--line);border-radius:var(--radius);background:var(--card);padding:20px 16px;text-align:center;transition:.3s;display:flex;flex-direction:column}
.master:hover{border-color:var(--line2);transform:translateY(-4px)}
.avatar{width:124px;height:124px;border-radius:50%;margin:0 auto 20px;overflow:hidden;border:1px solid var(--gold);box-shadow:0 0 0 6px rgba(201,164,92,.08);background:#17120c}
.avatar svg,.mopt .mini svg{display:block;width:100%;height:100%}
.master{overflow:hidden}
.mphoto{margin:-20px -16px 15px;aspect-ratio:4/5;border-bottom:1px solid var(--line2);overflow:hidden;background:#15110d}
.mphoto img,.mopt .mini img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .6s}
.master:hover .mphoto img{transform:scale(1.04)}
.master h3{font-size:19px}
.master .role{color:var(--gold);font-size:11px;letter-spacing:.06em;text-transform:uppercase;margin:3px 0 9px}
.master p{color:var(--muted);font-size:12px;line-height:1.5;flex:1}
.master .chips{display:flex;flex-wrap:wrap;gap:5px;justify-content:center;margin:11px 0 13px}
.master .chip{font-size:10px;padding:4px 8px;border-radius:999px;border:1px solid var(--line2);color:#d8cfbd}
.master .chip.beard{background:rgba(201,164,92,.14);border-color:var(--gold);color:var(--gold2)}
.master .btn{padding:9px 10px;font-size:12px;white-space:normal;line-height:1.3}

/* booking */
#booking{background:radial-gradient(900px 500px at 10% 0,rgba(201,164,92,.1),transparent 60%),var(--bg)}
.book-grid{display:grid;grid-template-columns:1.6fr 1fr;gap:28px;align-items:start}
.panel{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:30px}
.fs{margin-bottom:30px}
.fs:last-child{margin-bottom:0}
.fs-title{display:flex;align-items:center;gap:12px;font-weight:600;margin-bottom:14px}
.fs-title i{font-style:normal;width:28px;height:28px;border-radius:50%;background:var(--gold);color:#17120a;display:grid;place-items:center;font-size:13px;font-weight:700}
.svc-group{margin-bottom:14px}
.svc-group>small{display:block;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.svc-opts{display:flex;flex-wrap:wrap;gap:8px}
.opt{position:relative}
.opt input{position:absolute;opacity:0;inset:0;cursor:pointer;width:100%;height:100%}
.opt span{display:flex;gap:8px;align-items:center;padding:10px 16px;border:1px solid var(--line2);border-radius:12px;font-size:14px;transition:.2s;background:var(--bg2)}
.opt span b{color:var(--gold2);font-weight:600}
.opt input:checked+span{background:rgba(201,164,92,.16);border-color:var(--gold);color:var(--cream)}
.opt input:focus-visible+span{outline:2px solid var(--gold2);outline-offset:2px}
.mgrid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}
.mopt{position:relative}
.mopt input{position:absolute;opacity:0;inset:0;width:100%;height:100%;cursor:pointer}
.mopt span{display:flex;flex-direction:column;align-items:center;gap:6px;padding:14px 6px;border:1px solid var(--line2);border-radius:14px;font-size:13px;text-align:center;background:var(--bg2);transition:.2s;height:100%}
.mopt .mini{width:64px;height:64px;flex:none;overflow:hidden;border-radius:50%;display:grid;place-items:center;font-family:var(--serif);color:var(--gold2);border:1px solid var(--gold);background:#1c1610;box-shadow:0 0 0 3px rgba(201,164,92,.08)}
.mopt input:checked+span .mini{box-shadow:0 0 0 4px rgba(201,164,92,.2)}
.mopt:hover span{border-color:var(--gold);transform:translateY(-2px)}
.mopt input:checked+span{background:rgba(201,164,92,.16);border-color:var(--gold)}
.mopt input:focus-visible+span{outline:2px solid var(--gold2);outline-offset:2px}
.days{display:flex;gap:8px;overflow-x:auto;padding-bottom:10px;scrollbar-width:thin;scrollbar-color:var(--gold) transparent}
.day{flex:none;width:70px;padding:12px 0;border:1px solid var(--line2);border-radius:14px;text-align:center;background:var(--bg2);transition:.2s}
.day small{display:block;font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
.day b{font-family:var(--serif);font-size:22px;display:block;line-height:1.2}
.day:hover{border-color:var(--gold)}
.day.active{background:var(--gold);color:#17120a;border-color:var(--gold)}
.day.active small{color:#3a2d14}
.slots{display:grid;grid-template-columns:repeat(auto-fill,minmax(82px,1fr));gap:8px}
.slot{padding:11px 0;border:1px solid var(--line2);border-radius:10px;text-align:center;font-size:14px;font-weight:500;background:var(--bg2);transition:.2s}
.slot:hover:not([disabled]){border-color:var(--gold);color:var(--gold2)}
.slot.active{background:var(--gold);color:#17120a;border-color:var(--gold);font-weight:700}
.slot[disabled]{opacity:.28;text-decoration:line-through;cursor:not-allowed}
.hint{font-size:13px;color:var(--muted);margin-top:10px}
.hint.warn{color:var(--gold2)}
.fields{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.field{display:flex;flex-direction:column;gap:6px}
.field.full{grid-column:1/-1}
.field label{font-size:13px;color:var(--muted)}
.field input,.field textarea,.field select{background:var(--bg2);border:1px solid var(--line2);border-radius:12px;padding:13px 16px;outline:0;transition:.2s;width:100%}
.field textarea{resize:vertical;min-height:80px}
.field input:focus,.field textarea:focus,.field select:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(201,164,92,.15)}
.field.invalid input,.field.invalid textarea{border-color:var(--err)}
.err{color:var(--err);font-size:12px;display:none}
.field.invalid .err{display:block}
.check{display:flex;gap:12px;align-items:flex-start;font-size:14px;color:#d8cfbd;cursor:pointer}
.check input{accent-color:var(--gold);width:18px;height:18px;margin-top:3px;flex:none}
.summary{position:sticky;top:100px}
.sum-row{display:flex;justify-content:space-between;gap:12px;padding:10px 0;font-size:15px;border-bottom:1px dashed var(--line)}
.sum-row span:last-child{white-space:nowrap}
.sum-row.muted{color:var(--muted);font-size:14px}
.sum-row.disc{color:var(--ok)}
.sum-total{display:flex;justify-content:space-between;align-items:baseline;padding:18px 0 6px;font-family:var(--serif);font-size:28px}
.sum-total b{color:var(--gold2);font-size:34px}
.sum-empty{color:var(--muted);padding:12px 0;font-size:14px}
.promise{margin:18px 0;padding:14px 16px;border-radius:12px;background:rgba(201,164,92,.08);border:1px solid var(--line2);font-size:13px;color:#d8cfbd}
.promise b{color:var(--gold2)}
.mybook{margin-top:36px}
.mybook h3{margin-bottom:16px}
.bk{display:flex;justify-content:space-between;gap:16px;align-items:center;padding:16px 20px;border:1px solid var(--line);border-radius:14px;background:var(--card);margin-bottom:10px;flex-wrap:wrap}
.bk b{font-family:var(--serif);font-size:18px}
.bk small{color:var(--muted);display:block}
.bk .x{color:var(--err);font-size:13px;border:1px solid rgba(239,107,91,.4);padding:8px 16px;border-radius:999px}
.bk .x:hover{background:rgba(239,107,91,.12)}

/* promo */
.promo{background:linear-gradient(120deg,#2b2113,#17120c 60%);border:1px solid var(--line2);border-radius:28px;padding:56px;display:grid;grid-template-columns:auto 1fr auto;gap:44px;align-items:center;position:relative;overflow:hidden}
.promo::after{content:"";position:absolute;right:-80px;top:-80px;width:320px;height:320px;border-radius:50%;background:radial-gradient(circle,rgba(201,164,92,.2),transparent 70%)}
.promo .big{font-family:var(--serif);font-size:clamp(70px,10vw,130px);color:var(--gold2);line-height:.9;font-weight:700}
.promo h2{margin-top:0}
.promo ul{margin-top:14px}
.promo li{padding:3px 0;color:#d8cfbd;font-size:15px;display:flex;gap:10px}
.promo li .ico{color:var(--ok);margin-top:5px}
.promo > *{position:relative;z-index:1}

/* gallery */
.gal{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:220px;gap:14px}
.gal .photo{aspect-ratio:auto;border-radius:16px}
.gal .photo:nth-child(1){grid-column:span 2;grid-row:span 2}
.gal .photo:nth-child(4){grid-column:span 2}

/* hygiene */
#hygiene{background:var(--bg2)}
.hy{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.hy>div{padding:26px 22px;border-left:1px solid var(--gold)}
.hy b{font-family:var(--serif);font-size:19px;display:block;margin-bottom:6px}
.hy p{color:var(--muted);font-size:14px}

/* reviews */
.rev-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:28px;align-items:start}
.revs{display:grid;gap:16px}
.rev{padding:26px;border:1px solid var(--line);border-radius:var(--radius);background:var(--card)}
.rev-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;gap:10px;flex-wrap:wrap}
.rev-top b{font-family:var(--serif);font-size:18px}
.stars{color:var(--gold2);letter-spacing:2px}
.rev p{color:#d8cfbd;font-size:15px}
.rev small{color:var(--muted);display:block;margin-top:10px;font-size:12px}
.reply{margin-top:14px;padding:12px 16px;border-left:2px solid var(--gold);background:rgba(201,164,92,.06);font-size:14px;color:#d8cfbd;border-radius:0 10px 10px 0}
.reply b{color:var(--gold2)}
.starpick{display:flex;flex-direction:row-reverse;justify-content:flex-end;gap:2px}
.starpick input{display:none}
.starpick label{font-size:30px;color:#4a4136;cursor:pointer;transition:.15s;line-height:1}
.starpick input:checked~label,.starpick label:hover,.starpick label:hover~label{color:var(--gold2)}
.problem{margin-top:22px;padding:22px;border-radius:var(--radius);border:1px dashed var(--line2)}
.problem h4{font-family:var(--serif);font-size:18px;margin-bottom:6px;color:var(--gold2)}
.problem p{font-size:14px;color:var(--muted)}

/* faq */
#faq{background:var(--bg2)}
.faq{max-width:820px;margin:0 auto}
.q{border-bottom:1px solid var(--line)}
.q button{width:100%;display:flex;justify-content:space-between;align-items:center;text-align:left;padding:24px 0;font-family:var(--serif);font-size:20px;gap:20px}
.q button:hover{color:var(--gold2)}
.q .pl{width:30px;height:30px;border-radius:50%;border:1px solid var(--line2);display:grid;place-items:center;flex:none;transition:.3s;color:var(--gold)}
.q.open .pl{transform:rotate(45deg);background:var(--gold);color:#17120a}
.q .a{max-height:0;overflow:hidden;transition:max-height .35s ease;color:var(--muted)}
.q .a p{padding:0 50px 24px 0}

/* contacts */
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px}
.cinfo{display:grid;gap:18px}
.crow{display:flex;gap:16px;align-items:flex-start}
.crow .ic{width:46px;height:46px;border-radius:12px;border:1px solid var(--line2);display:grid;place-items:center;color:var(--gold2);font-size:20px;flex:none}
.crow small{color:var(--muted);display:block;font-size:13px}
.crow b{font-weight:600;font-size:17px}
.crow a:hover{color:var(--gold2)}
.hours{width:100%;border-collapse:collapse;margin-top:6px;font-size:14px}
.hours td{padding:6px 0;border-bottom:1px dashed var(--line)}
.hours td:last-child{text-align:right}
.mapbox{border-radius:var(--radius);border:1px solid var(--line2);overflow:hidden;position:relative;min-height:360px;background:#120f0b}
.mapbox iframe{position:absolute;inset:0;width:100%;height:100%;border:0;filter:invert(92%) hue-rotate(180deg) brightness(.95) contrast(.92) saturate(.6)}
.maplabel{position:absolute;left:12px;right:12px;top:12px;display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;background:rgba(11,10,9,.9);backdrop-filter:blur(8px);border:1px solid var(--line2);border-radius:14px;padding:10px 14px;font-size:14px}
.maplabel b{display:block;font-family:var(--serif);font-size:17px}
.maplabel span{color:var(--muted);font-size:13px}

footer{border-top:1px solid var(--line);padding:50px 0 100px;color:var(--muted);font-size:14px}
.foot{display:flex;justify-content:space-between;gap:30px;flex-wrap:wrap;align-items:center}

/* modal + toast */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.75);backdrop-filter:blur(6px);z-index:100;display:none;place-items:center;padding:20px}
.overlay.show{display:grid;animation:fade .25s}
.modal{background:var(--card);border:1px solid var(--line2);border-radius:24px;padding:40px;max-width:480px;width:100%;text-align:center;position:relative}
.modal .okc{width:70px;height:70px;border-radius:50%;background:rgba(111,207,151,.12);border:1px solid var(--ok);color:var(--ok);display:grid;place-items:center;margin:0 auto 20px;font-size:32px}
.modal h3{font-size:28px;margin-bottom:10px}
.modal p{color:var(--muted);margin-bottom:6px}
.modal .box{margin:22px 0;padding:18px;border-radius:14px;background:var(--bg2);border:1px solid var(--line);text-align:left;font-size:15px}
.modal .box div{display:flex;justify-content:space-between;gap:12px;padding:4px 0}
.modal .box span:first-child{color:var(--muted)}
.modal .btns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:20px}
@keyframes fade{from{opacity:0}}
.toast{position:fixed;left:50%;bottom:90px;transform:translate(-50%,30px);background:var(--card2);border:1px solid var(--gold);padding:14px 24px;border-radius:14px;z-index:120;opacity:0;pointer-events:none;transition:.35s;max-width:90vw;text-align:center;font-size:14px}
.toast.show{opacity:1;transform:translate(-50%,0)}

.modal.exit{max-width:520px;padding:0 40px 32px;overflow:hidden;background:linear-gradient(160deg,#2a2013,#15110d);border-color:var(--gold)}
.ex-big{font-family:var(--serif);font-size:clamp(84px,16vw,120px);font-weight:700;line-height:1;color:var(--gold2);margin:10px 0 6px}
.modal.exit h3{font-size:26px}
.ex-img{margin:0 -40px 22px;height:168px;position:relative;background:#15110d}
.ex-img img{width:100%;height:100%;object-fit:cover;display:block}
.ex-img::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#1b1610,transparent 70%)}
.modal.exit .ex-big{margin-top:6px}
.ex-timer-label{font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin:16px 0 8px}
.ex-timer{display:flex;justify-content:center;align-items:flex-start;gap:8px;margin-bottom:6px}
.ex-timer>div{min-width:76px;padding:10px 6px 8px;border:1px solid var(--line2);border-radius:12px;background:rgba(11,10,9,.6)}
.ex-timer b{display:block;font-family:var(--serif);font-size:34px;line-height:1;color:var(--gold2);font-variant-numeric:tabular-nums}
.ex-timer span{display:block;font-size:11px;color:var(--muted);margin-top:4px}
.ex-timer i{font-style:normal;font-size:30px;line-height:1.4;color:var(--gold)}
.promo-timer{margin-top:14px;font-size:15px;color:#d8cfbd}
.promo-timer b{font-family:var(--serif);font-size:22px;color:var(--gold2);font-variant-numeric:tabular-nums;margin-left:6px}
.x-close{z-index:2;background:rgba(11,10,9,.6);position:absolute;right:14px;top:14px;width:38px;height:38px;border-radius:50%;border:1px solid var(--line2);color:var(--muted);font-size:16px;display:grid;place-items:center;transition:.2s}
.x-close:hover{color:var(--gold2);border-color:var(--gold)}
.mobile-cta{display:none}
.reveal{opacity:0;transform:translateY(26px);transition:opacity .8s,transform .8s}
.reveal.in{opacity:1;transform:none}

/* responsive */
@media(max-width:1020px){
  .menu{display:none}
  .burger{display:flex}
  .menu.open{display:flex;flex-direction:column;position:absolute;top:76px;left:0;right:0;background:rgba(11,10,9,.97);padding:14px 20px 26px;gap:2px;border-bottom:1px solid var(--line)}
  .menu.open a{padding:14px 0;border-bottom:1px solid var(--line);font-size:16px}
  .phone span{display:none}
  .grid3{grid-template-columns:1fr 1fr}
  .grid5{grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}
  .grid5>*{grid-column:span 2}
  .grid5>:nth-child(4){grid-column:2/span 2}
  .grid5>:nth-child(5){grid-column:4/span 2;justify-self:stretch;width:auto}
  .steps{grid-template-columns:1fr 1fr}
  .price-wrap,.book-grid,.rev-grid,.contact-grid,.beard-split{grid-template-columns:1fr}
  .included,.summary{position:static}
  .hy{grid-template-columns:1fr 1fr}
  .promo{grid-template-columns:1fr;padding:38px 28px;gap:20px}
  .facts{grid-template-columns:1fr 1fr}
  .fact:nth-child(2){border-right:0}
  .fact:nth-child(-n+2){border-bottom:1px solid var(--line)}
  .gal{grid-template-columns:1fr 1fr;grid-auto-rows:180px}
}
@media(max-width:640px){
  .hero-bg img{width:100%;opacity:.62;-webkit-mask-image:none;mask-image:none}
  section{padding:68px 0}
  .grid3,.grid5,.steps,.hy{grid-template-columns:1fr}
  .grid5>* ,.grid5>:nth-child(4),.grid5>:nth-child(5){grid-column:1/-1;justify-self:stretch;width:auto}
  #masters{padding:54px 0}
  #masters .sec-head{margin-bottom:22px}
  .masters-team-banner{margin-bottom:18px;border-radius:14px}
  .nav-right .btn{display:none}
  .mgrid{grid-template-columns:repeat(3,1fr)}
  .fields{grid-template-columns:1fr}
  .panel{padding:22px 18px}
  .price-list{padding:6px 20px}
  .gal .photo:nth-child(1),.gal .photo:nth-child(4){grid-column:span 2}
  .gal .photo:nth-child(1){grid-row:span 1}
  .q button{font-size:18px}
  .q .a p{padding-right:0}
  .modal{padding:30px 22px}
  .mobile-cta{display:flex;position:fixed;left:12px;right:12px;bottom:12px;z-index:60;gap:10px}
  .mobile-cta .btn{flex:1;padding:14px 10px;box-shadow:0 10px 30px rgba(0,0,0,.6)}
  .mobile-cta .btn-ghost{background:rgba(11,10,9,.95);flex:none;padding:14px 18px}
  .toast{bottom:90px}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}html{scroll-behavior:auto}.reveal{opacity:1;transform:none}}


/* ===== Hair-care gift quiz ===== */
#quiz{background:radial-gradient(850px 480px at 90% 20%,rgba(201,164,92,.11),transparent 62%),linear-gradient(180deg,#100e0c,#0b0a09)}
.quiz-banner{width:min(1020px,100%);height:clamp(180px,22vw,245px);margin:0 auto 18px;border:1px solid var(--line2);border-radius:22px;overflow:hidden;background-color:#100e0c;background-image:linear-gradient(90deg,rgba(8,8,8,.12),rgba(8,8,8,.02) 58%,rgba(8,8,8,.12)),url("data:image/webp;base64,");background-position:center 48%;background-size:cover;background-repeat:no-repeat;box-shadow:0 20px 55px rgba(0,0,0,.32)}
.quiz-shell{max-width:1020px;margin:0 auto;display:grid;grid-template-columns:minmax(230px,.72fr) minmax(0,1.55fr);overflow:hidden;border:1px solid var(--line2);border-radius:26px;background:linear-gradient(145deg,#1b1712,#12100e);box-shadow:0 26px 70px rgba(0,0,0,.28)}
.quiz-aside{position:relative;isolation:isolate;display:flex;flex-direction:column;justify-content:space-between;min-height:500px;padding:34px 30px;background:radial-gradient(circle at 20% 15%,rgba(230,201,132,.2),transparent 35%),linear-gradient(155deg,#302314,#17120c 72%);border-right:1px solid var(--line2)}
.quiz-aside:after{content:"✦";position:absolute;z-index:-1;right:-8px;bottom:30px;font-size:170px;line-height:1;color:rgba(230,201,132,.07);transform:rotate(-12deg)}
.quiz-aside .eyebrow{font-size:10px;letter-spacing:.2em}
.quiz-aside h3{font-size:clamp(26px,3vw,34px);margin:22px 0 12px;color:var(--cream)}
.quiz-aside p{font-size:14px;color:#c0b39e;max-width:250px}
.quiz-aside-list{display:grid;gap:13px;margin-top:30px}
.quiz-aside-list span{display:flex;align-items:center;gap:10px;font-size:13px;color:#e4d8c4}
.quiz-aside-list i{display:grid;place-items:center;width:25px;height:25px;border:1px solid rgba(230,201,132,.45);border-radius:50%;color:var(--gold2);font-style:normal;font-size:12px;flex:none}
.quiz-aside-foot{font-family:var(--serif);font-size:17px;color:var(--gold2);margin-top:34px}
.quiz-main{padding:36px 42px 32px;min-width:0}
.quiz-progress-head{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:11px}
.quiz-progress-label{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.quiz-progress-count{font-size:13px;color:var(--gold2);font-variant-numeric:tabular-nums}
.quiz-slider-row{display:flex;align-items:center;gap:14px;margin:34px 0 30px}
.quiz-slider{--p:0;position:relative;flex:1;min-width:0;height:22px;display:flex;align-items:center}
.quiz-slider-track{position:relative;width:100%;height:6px;background:rgba(231,208,160,.13);border-radius:99px}
.quiz-slider-fill{position:absolute;left:0;top:0;height:100%;width:calc(11px + (100% - 22px) * var(--p));border-radius:99px;background:linear-gradient(90deg,var(--gold),var(--gold2));transition:width .35s ease}
.quiz-slider-thumb{position:absolute;top:50%;left:calc(11px + (100% - 22px) * var(--p));width:22px;height:22px;border-radius:50%;transform:translate(-50%,-50%);background:radial-gradient(circle at 35% 30%,var(--gold2),var(--gold));border:3px solid #17120a;box-shadow:0 0 0 2px var(--gold),0 6px 16px -4px rgba(201,164,92,.7);transition:left .35s ease}
.quiz-slider-pct{position:absolute;left:50%;bottom:calc(100% + 9px);transform:translateX(-50%);padding:3px 9px;border-radius:8px;background:var(--gold2);color:#17120a;font-size:12px;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;pointer-events:none}
.quiz-slider-pct:after{content:"";position:absolute;left:50%;top:100%;margin-left:-4px;border:4px solid transparent;border-top-color:var(--gold2)}
.quiz-slider-gift{flex:none;width:38px;height:38px;border-radius:50%;display:grid;place-items:center;border:1px solid var(--line2);color:var(--muted);transition:.35s}
.quiz-slider-gift svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.quiz-slider-row.full .quiz-slider-gift{border-color:var(--gold);background:rgba(201,164,92,.16);color:var(--gold2);box-shadow:0 0 0 6px rgba(201,164,92,.1)}
.quiz-lead{display:none}
.quiz-lead .fields{margin-top:4px}
.quiz-lead .quiz-actions{margin-top:24px}
.quiz-lead-note{min-height:18px;margin-top:12px;font-size:12px;color:var(--muted)}
.quiz-lead-note.bad{color:var(--err)}
.quiz-lead-safe{margin-top:14px;font-size:12px;color:#a99e8d;line-height:1.5}
.quiz-sent{max-width:620px;margin:0 auto 18px;padding:12px 16px;border:1px solid rgba(201,164,92,.4);border-radius:12px;background:rgba(201,164,92,.09);color:var(--gold2);font-size:14px}
.quiz-sent:empty{display:none}
.quiz-question-kicker{font-size:12px;color:var(--gold);letter-spacing:.12em;text-transform:uppercase;margin-bottom:9px}
.quiz-question-title{font-family:var(--serif);font-size:clamp(25px,3vw,33px);line-height:1.18;margin-bottom:9px}
.quiz-question-subtitle{color:var(--muted);font-size:14px;margin-bottom:24px}
.quiz-choices{display:grid;grid-template-columns:1fr 1fr;gap:11px}
.quiz-choice{position:relative;display:block;cursor:pointer;min-width:0}
.quiz-choice input{position:absolute;opacity:0;inset:0;width:100%;height:100%;cursor:pointer}
.quiz-choice-body{min-height:66px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:15px 16px;border:1px solid var(--line2);border-radius:13px;background:rgba(11,10,9,.45);color:#e7dece;font-size:14px;transition:border-color .2s,background .2s,transform .2s}
.quiz-choice:hover .quiz-choice-body{border-color:var(--gold);transform:translateY(-1px)}
.quiz-choice input:checked+.quiz-choice-body{background:rgba(201,164,92,.14);border-color:var(--gold);color:var(--gold2);box-shadow:inset 0 0 0 1px rgba(201,164,92,.15)}
.quiz-choice input:focus-visible+.quiz-choice-body{outline:2px solid var(--gold2);outline-offset:3px}
.quiz-choice-check{width:20px;height:20px;border:1px solid var(--line2);border-radius:50%;display:grid;place-items:center;flex:none;color:transparent;font-size:12px}
.quiz-choice input:checked+.quiz-choice-body .quiz-choice-check{background:var(--gold);border-color:var(--gold);color:#17120a}
.quiz-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:28px;padding-top:21px;border-top:1px solid var(--line)}
.quiz-back{color:var(--muted);font-size:14px;padding:12px 4px;transition:color .2s}
.quiz-back:hover:not(:disabled){color:var(--cream)}
.quiz-back:disabled{opacity:.3;cursor:not-allowed}
.quiz-next:disabled{opacity:.4;box-shadow:none;transform:none;cursor:not-allowed}
.quiz-result{display:none;text-align:center;padding:12px 0 5px}
.quiz-result.show{display:block;animation:quizAppear .35s ease both}
@keyframes quizAppear{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.quiz-gift-icon{width:76px;height:76px;margin:0 auto 22px;border-radius:50%;display:grid;place-items:center;border:1px solid var(--gold);background:rgba(201,164,92,.1);color:var(--gold2);box-shadow:0 0 0 9px rgba(201,164,92,.045)}
.quiz-gift-icon svg{width:37px;height:37px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.quiz-result h3{font-size:clamp(28px,3vw,36px);margin-bottom:12px}
.quiz-result>p{max-width:600px;margin:0 auto 20px;color:var(--muted);font-size:15px}
.quiz-summary{max-width:620px;margin:22px auto 18px;padding:16px 19px;text-align:left;border:1px solid var(--line);border-radius:14px;background:rgba(11,10,9,.35)}
.quiz-summary-title{font-size:11px;color:var(--gold);letter-spacing:.13em;text-transform:uppercase;margin-bottom:9px}
.quiz-summary-row{display:flex;justify-content:space-between;gap:15px;padding:7px 0;border-bottom:1px dashed var(--line);font-size:13px}
.quiz-summary-row:last-child{border:0}
.quiz-summary-row span:first-child{color:var(--muted)}
.quiz-summary-row span:last-child{text-align:right;color:#e8dfd0}
.quiz-care-plan{max-width:720px;margin:18px auto 24px;padding:20px;text-align:left;border:1px solid var(--line2);border-radius:16px;background:linear-gradient(145deg,rgba(42,32,19,.88),rgba(15,13,11,.94))}
.quiz-care-plan-head{margin-bottom:14px}
.quiz-care-plan-kicker{display:block;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);margin-bottom:6px}
.quiz-care-plan h4{font-family:var(--serif);font-size:23px;color:var(--gold2);margin-bottom:5px}
.quiz-care-plan-intro{color:#c0b39e;font-size:13px}
.quiz-care-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.quiz-care-card{padding:13px 14px;border:1px solid rgba(231,208,160,.16);border-radius:12px;background:rgba(8,8,8,.4)}
.quiz-care-card small{display:block;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);margin-bottom:5px}
.quiz-care-card b{display:block;font-size:14px;color:#f1e7d5;margin-bottom:5px}
.quiz-care-card p{font-size:12px;line-height:1.5;color:#bdb19e}
.quiz-care-footnote{margin-top:13px;color:#a99e8d;font-size:11px;line-height:1.5}
.quiz-result-actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}
.quiz-link-note{min-height:20px;margin-top:13px;color:var(--muted);font-size:12px}
.quiz-restart{font-size:13px;color:var(--muted);text-decoration:underline;text-underline-offset:4px;margin-top:13px}
.quiz-restart:hover{color:var(--gold2)}
@media(max-width:760px){
  .quiz-banner{height:190px;margin-bottom:14px;background-position:center 48%}
  .quiz-shell{grid-template-columns:1fr}
  .quiz-aside{min-height:0;padding:25px 26px 22px;border-right:0;border-bottom:1px solid var(--line2)}
  .quiz-aside h3{font-size:25px;margin:12px 0 7px}
  .quiz-aside p{max-width:560px}
  .quiz-aside-list{grid-template-columns:repeat(3,1fr);gap:9px;margin-top:18px}
  .quiz-aside-list span{font-size:11px;gap:6px}
  .quiz-aside-list i{width:22px;height:22px}
  .quiz-aside-foot{display:none}
  .quiz-main{padding:27px 26px 25px}
  .quiz-progress{margin-bottom:27px}
}
@media(max-width:520px){
  .quiz-banner{height:145px;border-radius:16px;background-position:center 48%}
  .quiz-care-grid{grid-template-columns:1fr}
  .quiz-care-plan{padding:15px}
  .quiz-aside{padding:22px 19px 18px}
  .quiz-aside-list{grid-template-columns:1fr;gap:8px;margin-top:14px}
  .quiz-aside-list span{font-size:12px}
  .quiz-main{padding:24px 18px 21px}
  .quiz-choices{grid-template-columns:1fr;gap:9px}
  .quiz-choice-body{min-height:58px;padding:13px 14px}
  .quiz-question-title{font-size:25px}
  .quiz-actions{margin-top:22px}
  .quiz-next{padding:13px 19px}
  .quiz-summary-row{font-size:12px}
}

</style>
</head>
<body>

